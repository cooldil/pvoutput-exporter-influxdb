# Copy to .env and fill in. Used by docker-compose and substituted into config.yaml.

# Timezone of your PVOutput system (IANA name, e.g. Europe/London, America/New_York)
TZ=America/New_York

PVOUTPUT_API_KEY=
PVOUTPUT_SYSTEM_ID=

INFLUX_VERSION=2
INFLUX_URL=http://influxdb2:8086

# InfluxDB 2.x
INFLUX_TOKEN=
INFLUX_ORG=Ravin
INFLUX_BUCKET=solaredge

# InfluxDB 1.x
INFLUX_DATABASE=solaredge
INFLUX_USERNAME=
INFLUX_PASSWORD=

LOG_LEVEL=INFO
